// Paste into a standalone Google Apps Script project owned by your Gmail account.
// Script properties: INVITATION_SECRET (private connection key), OWNER_EMAIL (your email).
function authorizeEmail() {
  console.log('Destinatarios disponibles hoy: ' + MailApp.getRemainingDailyQuota());
}
function doPost(e) {
  var lock;
  try {
    var request = JSON.parse(e.postData.contents);
    var properties = PropertiesService.getScriptProperties();
    var secret = properties.getProperty('INVITATION_SECRET');
    var owner = properties.getProperty('OWNER_EMAIL');
    if (!secret || !owner || typeof request.payload !== 'string' || request.payload.length > 8000000) return reply_({ok:false,code:'configuration'});
    if (!/^\d{13}$/.test(String(request.timestamp)) || Math.abs(Date.now() - Number(request.timestamp)) > 600000) return reply_({ok:false,code:'expired'});
    var bytes = Utilities.computeHmacSha256Signature(request.timestamp + '.' + request.payload, secret);
    var expected = Utilities.base64EncodeWebSafe(bytes).replace(/=+$/, '');
    var provided = String(request.signature || '');
    var mismatch = expected.length ^ provided.length;
    for (var i=0; i<expected.length; i++) mismatch |= expected.charCodeAt(i) ^ (provided.charCodeAt(i) || 0);
    if (mismatch) return reply_({ok:false,code:'authentication'});
    var data = JSON.parse(request.payload);
    if (data.kind === 'ping') return reply_({ok:true,remaining:MailApp.getRemainingDailyQuota(),owner:owner,emailDesignVersion:3,invitationAttachments:true});
    if (['owner','guest'].indexOf(data.kind) === -1 || !/^[a-f0-9-]{36}$/i.test(data.id) || typeof data.text !== 'string' || data.text.length > 6000 || typeof data.subject !== 'string' || data.subject.length > 200) return reply_({ok:false,code:'invalid'});
    var to = data.kind === 'owner' ? owner : data.to;
    if (data.kind === 'owner' && data.to !== owner) return reply_({ok:false,code:'owner_mismatch'});
    if (typeof to !== 'string' || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(to) || to.length > 254) return reply_({ok:false,code:'recipient'});
    var attachments = [];
    if (data.kind === 'guest' && data.attachments != null) {
      if (!Array.isArray(data.attachments) || data.attachments.length > 20) return reply_({ok:false,code:'attachments'});
      var totalBytes = 0;
      for (var ai=0; ai<data.attachments.length; ai++) {
        var file = data.attachments[ai];
        if (!file || file.mimeType !== 'image/jpeg' || typeof file.name !== 'string' || !/^Invitacion-[a-z0-9-]+\.jpg$/i.test(file.name) || file.name.length > 120 || typeof file.base64 !== 'string' || !/^[A-Za-z0-9+/]+={0,2}$/.test(file.base64)) return reply_({ok:false,code:'attachments'});
        var imageBytes = Utilities.base64Decode(file.base64);
        totalBytes += imageBytes.length;
        if (totalBytes > 5*1024*1024 || imageBytes.length < 3 || (imageBytes[0]&255) !== 255 || (imageBytes[1]&255) !== 216 || (imageBytes[2]&255) !== 255) return reply_({ok:false,code:'attachments'});
        attachments.push(Utilities.newBlob(imageBytes, 'image/jpeg', file.name));
      }
    }
    lock = LockService.getScriptLock();
    if (!lock.tryLock(5000)) return reply_({ok:false,retry:true,code:'busy'});
    var key = 'job_' + data.id;
    var old = properties.getProperty(key);
    if (old) { var previous = JSON.parse(old); return reply_(previous.state === 'sent' ? {ok:true,duplicate:true,id:data.id} : {ok:false,uncertain:true}); }
    if (MailApp.getRemainingDailyQuota() < 1) return reply_({ok:false,retry:true,code:'quota'});
    // Mark first: an interrupted or ambiguous send is never repeated silently.
    properties.setProperty(key, JSON.stringify({state:'sending',at:Date.now()}));
    try {
      var message = {to:to,subject:data.subject,body:data.text,name:'Revelación del bebé · Una dulce sorpresa',replyTo:owner,htmlBody:emailHtml_(data)};
      message.inlineImages = {honey:Utilities.newBlob(Utilities.base64Decode(HONEY_IMAGE_), 'image/jpeg', 'tarrito-de-miel.jpg')};
      if (attachments.length) message.attachments = attachments;
      MailApp.sendEmail(message);
    }
    catch (error) { return reply_({ok:false,uncertain:true}); }
    properties.setProperty(key, JSON.stringify({state:'sent',at:Date.now()}));
    var all = properties.getProperties();
    for (var property in all) if (property.indexOf('job_') === 0) {
      try { if (Date.now() - JSON.parse(all[property]).at > 7*24*60*60*1000) properties.deleteProperty(property); } catch (ignore) {}
    }
    return reply_({ok:true,id:data.id});
  } catch (error) { return reply_({ok:false,retry:true,code:'request'}); }
  finally { if (lock && lock.hasLock()) lock.releaseLock(); }
}
function reply_(value) {
  return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);
}

// Table layout and inline styles work without remote images or tracking links.
function escapeEmail_(value) {
  return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; });
}
function emailHtml_(data) {
  var p = data.presentation || {}, guest = data.kind === 'guest';
  var families = escapeEmail_(String(p.families || '').slice(0,700));
  var title = guest ? '¡Qué alegría contar con ustedes!' : 'Una familia se suma a la sorpresa';
  var intro = guest ? 'Su asistencia a la revelación de nuestro bebé está confirmada.' : 'Tenemos una nueva confirmación para compartir esta enorme ilusión.';
  var content;
  if (families) {
    content = '<p style="margin:0 0 10px;color:#a95235;font-size:12px;letter-spacing:2px;font-weight:bold">FAMILIA CONFIRMADA</p><h2 style="margin:0 0 20px;color:#43586a;font-size:24px;line-height:1.4">'+families+'</h2>';
    if (!guest) content += '<p style="margin:0 0 20px;font-size:15px;line-height:1.7">Personas: '+escapeEmail_(p.people)+'<br>Registró: '+escapeEmail_(p.visitor)+'<br>Teléfono: '+escapeEmail_(p.phone)+'</p>';
    content += '<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f9f3e3;border:1px solid #e5dfce;border-radius:16px"><tr><td style="padding:24px"><p style="margin:0 0 12px;font-size:12px;letter-spacing:2px;color:#a95235;font-weight:bold">NOS VEMOS EL</p><p style="margin:0 0 8px;font-size:21px;color:#a95235;font-weight:bold">'+escapeEmail_(p.date)+'</p><p style="margin:0 0 16px;font-size:22px;font-weight:bold">'+escapeEmail_(p.time)+'</p><p style="margin:0;font-size:15px;line-height:1.6">'+escapeEmail_(p.place)+'</p></td></tr></table>';
  } else content = '<p style="font-size:16px;line-height:1.8">'+escapeEmail_(data.text).replace(/\n/g,'<br>')+'</p>';
  return '<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Asistencia confirmada</title></head><body style="margin:0;background:#f2f0e6;color:#43586a;font-family:Arial,Helvetica,sans-serif"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:24px 12px"><table role="presentation" width="580" cellpadding="0" cellspacing="0" style="width:100%;max-width:580px;background:#fffef2;border-radius:24px;border:1px solid #e5dfce"><tr><td align="center" style="padding:30px 24px 12px"><p style="margin:0;color:#a95235;font-size:11px;letter-spacing:2px">UN PEQUEÑO SECRETO, UNA ENORME ILUSIÓN</p><img src="cid:honey" alt="Un tarrito de miel con un corazón" width="180" style="display:block;width:180px;max-width:100%;height:auto;margin:16px auto"><h1 style="margin:0;color:#7198cc;font-family:Georgia,serif;font-size:32px;line-height:1.2;font-weight:normal">'+title+'</h1><p style="margin:18px 0 0;font-size:16px;line-height:1.7">'+intro+'</p></td></tr><tr><td style="padding:22px 28px 30px">'+content+'<p style="margin:24px 0 0;font-family:Georgia,serif;font-size:20px;font-style:italic;text-align:center;color:#7198cc">La alegría se multiplica contigo.</p></td></tr><tr><td style="padding:20px 28px;border-top:1px solid #e5dfce;text-align:center;font-size:12px;line-height:1.7;color:#697265">Recibiste este correo porque se confirmó una asistencia a nuestra celebración. Si necesitas corregir algún dato, puedes responder a este mensaje.</td></tr></table></td></tr></table></body></html>';
}
var HONEY_IMAGE_ = '';
